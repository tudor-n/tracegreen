# Copy to .env (git-ignored) when running services outside Docker. Compose sets these itself, except the AI
# models and keys, which it reads from the root .env (compose.yml passes them to the ai service only).

# ---- API (api/) ----
DATA_MODE=                      # memory | postgres. Default: postgres when DATABASE_URL is set, else memory
DATABASE_URL=postgres://tracegreen:tracegreen@localhost:5432/tracegreen
SEED_MODE=                      # 1 forces memory mode even when DATABASE_URL is set (offline fallback)
LINK_SECRET=                    # >= 32 chars. Required in Production; a fixed dev secret is used otherwise
LINK_TTL_SECONDS=604800         # verification link lifetime (7 days)
DEMO_TOOLS=1                    # 1 enables /api/dev/* (reset demo, simulate answer)
PUBLIC_BASE_URL=                # e.g. http://192.168.137.1:3000 — the origin phones can reach; overrides X-Forwarded-Host
ETS_PRICE_EUR_PER_T=70          # placeholder benchmark for the MAC badge; replace with the day's EUA price
AI_BASE_URL=http://localhost:8000
AI_TIMEOUT_MS=10000
RATE_LIMIT_PER_MIN=10           # /api/verify* per client IP
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12   # proxies whose X-Forwarded-For is believed (host + Docker pool)
SEED_DIR=                       # default: auto-detected ./seed; /seed inside Docker

# ---- AI service (ai/) ----
# Chain: cache -> the models in AI_MODELS, in order -> stub. Each entry is <provider>:<model>; the text before the
# first ':' is the provider (anthropic, openai, google_genai, ollama), the rest the model name, so Ollama tags with
# colons work. Example: AI_MODELS=openai:<model>,google_genai:<model>,ollama:ministral-3:3b
AI_MODELS=                      # empty = cache and stub only
AI_MODEL=                       # older form, read only while AI_MODELS is empty: counts as anthropic:<AI_MODEL>
ANTHROPIC_API_KEY=              # cloud keys: a model whose key is missing is skipped, and /health says why
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434   # the local model server (Ollama on the host)
AI_TIMEOUT_S=8                  # total budget for one /classify call; stays under the API's AI_TIMEOUT_MS (10 s)
AI_MODEL_TIMEOUT_S=4            # cap for each cloud model attempt
OLLAMA_TIMEOUT_S=6              # cap for the local model attempt
AI_DEV_ROUTES=0                 # 1 turns on POST /classify?model=<id> (scoring only: skips the cache, one model)

# ---- Web dev server (web/) ----
API_URL=http://localhost:8080   # Vite proxies /api here
CHOKIDAR_USEPOLLING=            # true inside Docker bind mounts
