# Demo-only settings for the laptop that serves phones over a hotspot. Committed on purpose.
# NOT for production: this secret is public. It is fixed so that QR codes printed before a restart stay valid.
LINK_SECRET=tracegreen-demo-only-secret-not-for-production-2026
DEMO_TOOLS=1
ETS_PRICE_EUR_PER_T=70
# The origin phones can reach, e.g. http://192.168.137.1:3000 (Windows Mobile Hotspot). Leave empty to derive from the request.
PUBLIC_BASE_URL=
